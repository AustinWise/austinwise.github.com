<!doctype html>
<html lang="en" prefix="og: https://ogp.me/ns#">

<head>
    {% include "head.liquid" %}

    <!-- fediverse attribution -->
    <meta name="fediverse:creator" content="@AustinWise@mastodon.social">

    <!-- https://ogp.me/ -->
    <meta property="og:title" content="{{ page.title }}" />
    <meta property="og:type" content="article" />
    <meta property="og:url" content="https://www.awise.us/{{ page.permalink }}" />
    <meta property="og:image" content="https://www.awise.us/Me.V5.jpeg" />

    <!-- Slop me up. -->
    <link rel="alternate" type="text/markdown" title="LLM-friendly version" href="https://raw.githubusercontent.com/AustinWise/austinwise.github.com/refs/heads/main/input/{{ page.file.permalink }}" />
</head>

<body>
    <div id="container">
        <header>
            Austin Wise
        </header>
        <main>
            <a class="homeLink" href="/">Go to home page</a>
            <hr />
            <div class="post">
                <span class="date">{{ page.published_date | date: "%Y-%m-%d" }}</span>
                <h2>{{ page.title }}</h2>
                {{ page.content }}
            </div>
        </main>
        <div>
            <h2>Like &amp; Subscribe</h2>
            If you would like to be notified of my future posts or would like to contact me,
            I am also online at these places:
            {% include "cta.liquid" %}
        </div>
        <footer>
            {% include "footer.liquid" %}
        </footer>
    </div>

</body>

</html>
