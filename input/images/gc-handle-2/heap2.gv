digraph G {
    compound=true;

    subgraph cluster_0 {
        d0 -> d1 -> d2 -> d0;
        d3 -> d4 -> d5 -> d6 -> d3;
        d6 -> d4;
        d0 -> d3;

        subgraph cluster_2 {
            label = "SSC 1";
            d0;
            d1;
            d2;
        }

        subgraph cluster_3 {
            label = "SSC 2";
            d3;
            d4;
            d5;
            d6;
        }

        d0 -> d3 [ltail=cluster_2, lhead=cluster_3, color=green, minlen = 2];

        label = ".NET GC Heap";
    }

    subgraph cluster_1 {
        j0 -> j1 -> j2;
        j3 -> j4 -> j5 -> j6;

        label = "Java GC Heap";
    }
}
